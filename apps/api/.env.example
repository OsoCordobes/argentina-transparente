# ARGOS API — environment variables
# Copy to .env and fill in. Never commit .env.

# ─── Core ─────────────────────────────────────────────────────────────────────
PORT=3002

# Path to DuckDB file (relative to apps/api/ CWD, or absolute)
# Canonical DB: co-locates casos with contratos (Córdoba Capital) + IGJ tables.
DB_PATH=../../backend/data/argos.duckdb

# Directory for content-addressed file snapshots (uploaded archivos land here)
SNAPSHOTS_DIR=../../data/snapshots

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required for /api/ai, /api/dossier, and OCR on file uploads
ANTHROPIC_API_KEY=

# Model overrides (optional — defaults in code)
# OCR_MODEL=claude-haiku-4-5-20251001
# DOSSIER_MODEL=claude-sonnet-4-6

# ─── Feedback → GitHub Issues ─────────────────────────────────────────────────
# PAT with `repo` scope (private) or `public_repo` (public)
GITHUB_TOKEN=
# Must be owner/repo form, e.g. "codigo-civico/argos"
GITHUB_REPO=

# ─── Auth (future: Clerk) ─────────────────────────────────────────────────────
# Not yet wired. Placeholder dev auth reads the X-User-Email header.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
