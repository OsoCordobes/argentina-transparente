{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend (Express + ts-node)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "backend",
      "port": 3001
    },
    {
      "name": "Frontend (Vite + React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 8080
    }
  ,
    {
      "name": "Neo4j Browser",
      "runtimeExecutable": "node",
      "runtimeArgs": ["neo4j-proxy.js"],
      "port": 7475
    }
  ]
}
