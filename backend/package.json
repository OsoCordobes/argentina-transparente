{
  "name": "argos-backend",
  "version": "3.0.0",
  "description": "ARGOS — motor anticorrupción ciudadano (backend TypeScript/Express)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:connector": "npx ts-node -e \"const {cordobaCapitalConnector} = require('./src/connectors/cordoba-capital'); cordobaCapitalConnector.getContratos(2023,2023).then(c => { console.log('Total contratos:', c.length); console.log('Muestra:', JSON.stringify(c.slice(0,3), null, 2)); }).catch(console.error)\"",
    "test:signals": "npx ts-node src/test-signals.ts",
    "test:e2e": "npx ts-node src/test-e2e.ts",
    "seed:cordoba": "npx ts-node src/scripts/seed-cordoba.ts",
    "seed:nacion": "npx ts-node src/scripts/seed-nacion.ts",
    "seed:caba": "npx ts-node src/scripts/seed-caba.ts",
    "seed:igj": "npx ts-node src/scripts/seed-igj.ts",
    "seed:afip": "npx ts-node src/scripts/seed-afip.ts",
    "seed:neo4j": "npx ts-node src/scripts/seed-neo4j.ts",
    "seed:opensanctions": "npx ts-node src/scripts/seed-opensanctions.ts",
    "seed:santafe": "npx ts-node src/scripts/seed-santafe.ts",
    "seed:icij": "npx ts-node src/scripts/seed-icij.ts",
    "seed:boletin": "npx ts-node src/scripts/seed-boletin-ocr.ts",
    "seed:boletin-cordoba": "npx ts-node src/scripts/seed-boletin-cordoba.ts",
    "seed:cordoba-normas": "npx ts-node src/scripts/seed-cordoba-normas.ts",
    "seed:all": "npm run seed:cordoba && npm run seed:nacion && npm run seed:igj && npm run seed:afip && npm run seed:neo4j && npm run seed:opensanctions",
    "analyze": "npx ts-node src/scripts/analyze.ts",
    "alertas:check": "npx ts-node src/scripts/check-alertas.ts",
    "ckan:explore": "npx ts-node src/scripts/ckan-explore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "dotenv": "^17.3.1",
    "duckdb": "^1.4.4",
    "express": "^4.18.2",
    "neo4j-driver": "^6.0.1",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
}
