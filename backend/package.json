{
  "name": "la-bestia-backend",
  "version": "2.0.0",
  "description": "Motor anticorrupción — backend TypeScript/Express",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:connector": "npx ts-node -e \"const {cordobaCapitalConnector} = require('./src/connectors/cordoba-capital'); cordobaCapitalConnector.getContratos(2023,2023).then(c => { console.log('Total contratos:', c.length); console.log('Muestra:', JSON.stringify(c.slice(0,3), null, 2)); }).catch(console.error)\"",
    "test:signals": "npx ts-node src/test-signals.ts",
    "test:e2e": "npx ts-node src/test-e2e.ts",
    "seed:cordoba": "npx ts-node src/scripts/seed-cordoba.ts",
    "seed:igj": "npx ts-node src/scripts/seed-igj.ts",
    "seed:afip": "npx ts-node src/scripts/seed-afip.ts",
    "seed:neo4j": "npx ts-node src/scripts/seed-neo4j.ts",
    "seed:all": "npm run seed:cordoba && npm run seed:igj && npm run seed:afip && npm run seed:neo4j",
    "analyze": "npx ts-node src/scripts/analyze.ts",
    "publish": "cp data/argos.duckdb ../reports/argos_snapshot.duckdb && cd ../reports && npx evidence build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "dotenv": "^17.3.1",
    "duckdb": "^1.4.4",
    "express": "^4.18.2",
    "neo4j-driver": "^6.0.1",
    "node-fetch": "^3.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
}
