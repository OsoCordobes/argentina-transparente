# ARGOS — Backend env vars (template)
# Copiar a `.env` y completar valores reales. .env está en .gitignore.

# ─── Anthropic (REQUERIDO para chat / suggestions / extractor / OCR) ────────
# Sin esta key los endpoints LLM devuelven 503 y los seeds que requieren
# extracción (boletín, normas) fallan al arrancar.
# Plan recomendado: pay-as-you-go con saldo cargado regularmente.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hard cap operativo del budget guard semanal en USD.
# Default 45 (margen 15% sobre ~$53 = €50/sem). Hard limit absoluto: 50.
# El budget se calcula desde el último viernes 00:00 UTC (alineado con
# recargas semanales del usuario).
ANTHROPIC_BUDGET_USD=45.00

# ─── Servidor ───────────────────────────────────────────────────────────────
PORT=3001

# ─── Neo4j (OPCIONAL — solo si querés señales de red de directores) ─────────
# Si Neo4j no responde, isGraphAvailable() devuelve false y los detectores
# detectarDirectoresCompartidos / detectarRedDeEmpresas se deshabilitan
# graceful, sin romper analyze.
# Defaults locales:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=argos_local

# ─── Notas ──────────────────────────────────────────────────────────────────
# - Toda var no documentada acá: agregar acá Y al README al usarla.
# - Para producción Railway: setearlas como Service Variables (no en .env).
# - El frontend NO comparte este archivo — usa frontend/.env.development y
#   frontend/.env.production (con prefijo VITE_*).
